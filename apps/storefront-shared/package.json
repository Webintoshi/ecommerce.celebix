{
  "name": "@celebix/storefront-shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3450",
    "build": "next build",
    "start": "next start --port 3450",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_OPTIONS='--conditions=react-server' node --experimental-transform-types --test lib/*.test.ts lib/checkout/*.test.ts lib/payment-adapters/*.test.ts lib/cart-capture/*.test.ts lib/analytics/*.test.ts components/StorefrontAnalyticsTracker.test.ts scripts/healthcheck.test.mjs",
    "reconcile:quick-orders": "NODE_OPTIONS='--conditions=react-server' node scripts/reconcile-quick-orders.mjs",
    "deliver:analytics": "NODE_OPTIONS='--conditions=react-server' node --experimental-transform-types scripts/deliver-analytics-events.mjs"
  },
  "dependencies": {
    "@celebix/payment-adapters": "0.1.0",
    "@celebix/platform-config": "0.1.0",
    "@celebix/saas-data": "0.1.0",
    "@celebix/saas-storefront-runtime": "0.1.0",
    "cross-env": "^10.1.0",
    "next": "16.2.1",
    "pg": "^8.22.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@celebix/saas-contracts": "0.1.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "typescript": "^5.9.3"
  }
}
