{
  "name": "celebix-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.8.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:owner": "npm run dev --workspace @celebix/owner",
    "dev:admin": "npm run dev --workspace @celebix/admin",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:saas-phase1": "node --experimental-transform-types --test tests/saas-phase1/*.test.ts",
    "test:saas-phase3:current": "node tests/saas-phase3/run-current-suite.mjs",
    "test:saas-phase3:browser": "node tests/saas-phase3/hemenaku-admin-presentation/browser-acceptance.mjs",
    "generate:iyzico-sandbox-build": "node --experimental-strip-types ./scripts/generate-iyzico-sandbox-build.mjs",
    "check:iyzico-sandbox-build": "node --experimental-strip-types ./scripts/generate-iyzico-sandbox-build.mjs --check",
    "test:iyzico-sandbox-build": "node --experimental-strip-types --test ./scripts/generate-iyzico-sandbox-build.test.mjs",
    "create:store": "node ./scripts/create-store.mjs",
    "migrate:selfhosted-store-db": "node ./apps/owner/scripts/migrate-store-db-selfhosted.mjs",
    "migrate:selfhosted-owner-db": "node ./apps/owner/scripts/migrate-owner-db-selfhosted.mjs"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "typescript": "^5.9.3"
  }
}
