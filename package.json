{
  "name": "celebix-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.8.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:owner": "npm run dev --workspace @celebix/owner",
    "dev:admin": "npm run dev --workspace @celebix/admin",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "create:store": "node ./scripts/create-store.mjs",
    "validate:deploy-branches": "node ./scripts/validate-deployment-branches.mjs",
    "setup:deployment-guardrails": "node ./scripts/install-deployment-guardrails.mjs",
    "deploy:owner": "node ./scripts/publish-deploy-branch.mjs --target owner",
    "deploy:storefront": "node ./scripts/publish-deploy-branch.mjs --target storefront",
    "deploy:auto": "node ./scripts/publish-deploy-branch.mjs --auto",
    "migrate:selfhosted-store-db": "node ./apps/owner/scripts/migrate-store-db-selfhosted.mjs",
    "migrate:selfhosted-owner-db": "node ./apps/owner/scripts/migrate-owner-db-selfhosted.mjs"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "typescript": "^5.9.3"
  }
}
